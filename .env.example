# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google APIs
GOOGLE_VISION_API_KEY=           # OCR (Dokument-Scan → Text)
GEMINI_API_KEY=                  # LLM Extraktion (Text → strukturierte Forderungsdaten)

# Webhooks
WEBHOOK_SECRET=                  # Bearer Token fuer Lead-Webhook

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=        # optional: WhatsApp-Business-Link fuer den Rechner-CTA
